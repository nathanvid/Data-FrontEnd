# Copier ce fichier en .env.local et le remplir. .env.local n'est jamais versionné.
#
# AUCUNE de ces variables ne commence par NEXT_PUBLIC_ : elles restent sur le serveur
# et ne sont jamais envoyées au navigateur.

# Supabase > Project Settings > API
SUPABASE_URL=https://ixfjkkdngnostcibjzpa.supabase.co

# Clé service (« service_role », ou nouvelle clé secrète « sb_secret_... »).
# Elle donne un accès total à la base : ne la mettez nulle part ailleurs.
SUPABASE_SERVICE_ROLE_KEY=
