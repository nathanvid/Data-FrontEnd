# Copier ce fichier en .env.local et le remplir. .env.local n'est jamais versionné.
#
# AUCUNE de ces variables ne commence par NEXT_PUBLIC_ : elles restent sur le serveur
# et ne sont jamais envoyées au navigateur.

# Supabase > Project Settings > API
SUPABASE_URL=https://ixfjkkdngnostcibjzpa.supabase.co

# Clé service (« service_role », ou nouvelle clé secrète « sb_secret_... »).
# Elle donne un accès total à la base : ne la mettez nulle part ailleurs.
SUPABASE_SERVICE_ROLE_KEY=

# Mailgun (envoi des liens personnels : scripts/preparer-liens.mjs)
# Mailgun > Sending > Domain settings > Sending API keys : clé limitée à pro.moncoinbureau.fr
MAILGUN_API_KEY=
# Optionnels (valeurs par défaut ci-dessous)
# MAILGUN_DOMAINE=pro.moncoinbureau.fr
# MAILGUN_API=https://api.eu.mailgun.net
# MAILGUN_EXPEDITEUR=MonCoinBureau Pro <admin@pro.moncoinbureau.fr>

# Administration (/admin) : mot de passe du formateur, 12 caractères minimum.
# Sans lui, l'administration reste fermée.
ADMIN_MOT_DE_PASSE=
# Envoi d'indices par mail depuis l'administration (utilise aussi MAILGUN_API_KEY).
# Boîte qui recevra les réponses des étudiants : surtout pas une adresse @pro.moncoinbureau.fr.
ADMIN_REPONDRE_A=
